# Portainer Stack environment
TZ=UTC

# Testing concurrency
MAX_CONCURRENCY=100
MAX_HOST_CONCURRENCY=5
CONNECT_TIMEOUT=5
READ_TIMEOUT=10
FFPROBE_TIMEOUT=15
SEGMENT_TEST_COUNT=3

# Automatic testing interval
TEST_INTERVAL_MINUTES=30

# Playlist filtering
MIN_SCORE=70
MIN_STABILITY=0.90

# API security: set a strong random token before exposing the API publicly.
API_TOKEN=

# If API_TOKEN is empty, all API and playlist endpoints are available without authentication.
# If API_TOKEN is set, this can still expose playlist endpoints without authentication.
PUBLIC_PLAYLIST=false

# Historical test data retention target.
HISTORY_RETENTION_DAYS=30

NETWORK_RETRIES=1
MAX_PLAYLIST_BYTES=2097152
MAX_SEGMENT_BYTES=33554432
# Remote M3U auto-delete after this many consecutive transient fetch failures
REMOTE_PLAYLIST_MAX_FAILURES=3
