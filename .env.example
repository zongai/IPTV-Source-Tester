DATABASE_URL=sqlite:///./data/iptv.db

# Origin-friendly concurrency: low per-host (serial domain queue).
MAX_CONCURRENCY=20
MAX_HOST_CONCURRENCY=1
CONNECT_TIMEOUT=5
READ_TIMEOUT=10
FFPROBE_TIMEOUT=15
# Full-mode only; keep low.
FFPROBE_CONCURRENCY=2
# 1–2 segments for liveness; raise for finer speed measurement.
SEGMENT_TEST_COUNT=2
TEST_INTERVAL_MINUTES=30
# Skip source if last tested within N minutes (0 = disable)
MIN_TEST_INTERVAL_MINUTES=30
# Optional separate full (FFprobe) schedule
FULL_TEST_ENABLED=false
FULL_TEST_INTERVAL_HOURS=24

MIN_SCORE=70
MIN_STABILITY=0.90
API_TOKEN=
PUBLIC_PLAYLIST=false
HISTORY_RETENTION_DAYS=30

NETWORK_RETRIES=1
MAX_PLAYLIST_BYTES=2097152
MAX_SEGMENT_BYTES=33554432
REMOTE_PLAYLIST_MAX_FAILURES=3
SOURCE_AUTO_DELETE_FAILURES=5
SOURCE_AUTO_DELETE_DAYS=5

# Pause a host after 403/429 (seconds)
HOST_COOLDOWN_SECONDS=180
# Mild default UA when source has no User-Agent
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
